{
  "name": "postit-desktop",
  "version": "1.0.0",
  "description": "Notas adesivas (post-it) para a área de trabalho",
  "main": "main.js",
  "author": "Seu Nome",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.meuapp.postit",
    "productName": "Post-it",
    "files": ["main.js", "preload.js", "note.html", "icon.png"],
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
